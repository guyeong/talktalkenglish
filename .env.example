# 로컬에서는 .env 파일을 만들고 아래 값을 입력하세요.
# 이 파일(.env)은 GitHub에 올리지 마세요.
GEMINI_API_KEY=AIza_your_key_here

# ElevenLabs 무료 API용. 브라우저 코드에 직접 넣지 마세요.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# 기본 ElevenLabs 음성 ID입니다. ElevenLabs Voice Library에서 선택한 Voice ID를 입력하세요.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# 아래 4개는 선택 사항입니다. 설정하면 기존 음성 선택 메뉴와 ElevenLabs 음성을 연결할 수 있습니다.
# ELEVENLABS_VOICE_US_FEMALE=
# ELEVENLABS_VOICE_US_MALE=
# ELEVENLABS_VOICE_UK_MALE=
# ELEVENLABS_VOICE_AU_FEMALE=
